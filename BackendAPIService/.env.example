# BackendAPIService - Example environment variables
# NOTE: Do not commit secrets. Copy this file to .env and set real values.

# Service
BACKEND_PORT=3001

# Logging
BACKEND_LOGGING__LEVEL=INFO
BACKEND_LOGGING__JSON=true
BACKEND_LOGGING__SERVICE_NAME=backend-api

# CORS
# Comma-separated list of origins, e.g. http://localhost:3000,https://your-frontend.app
BACKEND_CORS__ALLOW_ORIGINS=http://localhost:3000

# Security (development mode)
BACKEND_SECURITY__DEV_MODE=true
BACKEND_SECURITY__DEV_JWT=dev-token

# JWT verification for production hardening (set when DEV_MODE=false)
# If using symmetric JWT:
BACKEND_SECURITY__JWT_AUDIENCE=
BACKEND_SECURITY__JWT_ISSUER=
# If using asymmetric JWT via JWKS:
BACKEND_SECURITY__JWKS_URL=
# Optional: if you use an internal symmetric secret instead of JWKS, document in README.

# Database (placeholders for future persistence)
BACKEND_MONGO_URL=
BACKEND_MONGO_DB=

# Crypto (AES-256-GCM) required by encrypt_json/decrypt_json helpers
# 32-byte key base64-encoded (exactly 32 bytes when decoded).
# Generate securely (example):
# python - <<'PY'
# import os, base64; print(base64.b64encode(os.urandom(32)).decode())
# PY
ENCRYPTION_KEY_BASE64=
ENCRYPTION_KEY_ID=
