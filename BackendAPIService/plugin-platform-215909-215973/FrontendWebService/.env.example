# FrontendWebService - Example environment variables
# NOTE: Do not commit secrets. Copy to .env and fill in actual values.

# Public envs (exposed to browser via Next.js)
# Base URL for Backend API Service (include scheme and port)
NEXT_PUBLIC_API_URL=http://localhost:3001
# The origin of the frontend app itself (used by backend for CORS and OAuth redirects)
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
